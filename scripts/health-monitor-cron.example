# Install only after review. Run an initial restore check before enabling the monitor.
*/5 * * * * root /usr/bin/python3 /opt/funnelhub/scripts/health-monitor.py >> /var/log/funnelhub-health.log 2>&1
0 5 * * 0 root /bin/bash /opt/funnelhub/scripts/check-backup-restore.sh >> /var/log/funnelhub-restore-check.log 2>&1
